# PAhub uses process environment for server settings; it does not load this file.
# Vite reads the browser-side values below at build time.
VITE_DATA_API_BASE_URL=/api
VITE_DATA_API_TOKEN=
# Server: PORT=8080, PAHUB_DATA_DIR=<directory>, PAPC_DB_PATH=<directory>/papc.db
# Set API_TOKEN and ADMIN_PASSWORD in the server process environment.
# ADMIN_PASSWORD enables the administrator sign-in (POST /api/session).
# When it is unset every visitor is treated as an administrator (local development only).
# kjx directory is server-only; missing credentials enable manual-name fallback.
# AUTH_MODE=kjx
# KJX_INTERNAL_URL=http://127.0.0.1:8090
# KJX_CLIENT_ID=pahub-server
# KJX_CLIENT_SECRET=<secret>

