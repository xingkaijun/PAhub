# PAhub uses process environment for server settings; it does not load this file.
# Vite reads the browser-side values below at build time.
VITE_DATA_API_BASE_URL=/api
VITE_DATA_API_TOKEN=
VITE_PUSH_PASSWORD=
VITE_EDIT_PASSWORD=
# Server: PORT=8080, PAHUB_DATA_DIR=<directory>, PAPC_DB_PATH=<directory>/papc.db
# Set API_TOKEN and ADMIN_PASSWORD in the server process environment.

