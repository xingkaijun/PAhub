# Install from the Huawei Cloud npm mirror (fast in mainland China). package-lock.json keeps the official
# registry.npmjs.org URLs; npm swaps that host for this registry when it downloads (replace-registry-host=npmjs, the default).
# To use the official registry instead: npm ci --registry=https://registry.npmjs.org/
registry=https://repo.huaweicloud.com/repository/npm/
